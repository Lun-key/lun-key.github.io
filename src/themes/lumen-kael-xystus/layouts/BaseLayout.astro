---
/**
 * 文件头注释 —— 这个文件做什么：
 * 这是 lumen-kael-xystus 主题的「全站基础布局」（约 1200 行，本主题最大文件），
 * 负责每张页面共用的外壳：<!doctype html> 骨架、<head> 里的 SEO/字体/主题样式、
 * 站点导航 header、<main> 里的 <slot />（页面内容从此处注入）、footer 计时器，
 * 以及大量全局交互脚本：樱花雨、看板娘 Live2D、音乐播放器、自定义右键菜单、代码复制按钮等。
 * 被谁引用：几乎所有页面（Home/Projects/Blog/About/Article/404）与 ArticleLayout 都基于它。
 * 改它影响哪里：全站所有页面。想改单个页面内容请去 pages/，想改主题配色/间距通常改 styles/。
 * 文件结构速查：① frontmatter(1-57) ② head(59-83) ③ body 各区块(84-227) ④ 内联 script 标签(228-1225)。
 */
import "../styles/theme.css";
import "@/themes/lumen-kael-xystus/styles/refresh.css";
import "@/themes/lumen-kael-xystus/styles/manga.css";
import refreshPagesHref from "../styles/refresh-pages.css?url";
import mangaPagesHref from "../styles/manga-pages.css?url";
import { site } from "@/lib/site";
import type { BlogPost } from "@/core/content/blog";
import { Icon } from "astro-icon/components";
import { ClientRouter } from "astro:transitions";
import ThemePreferenceGate from "@/core/themes/ThemePreferenceGate.astro";
import ThemeLongPressMenu from "@/core/themes/ThemeLongPressMenu.astro";
import ConsoleEasterEgg from "@/core/ConsoleEasterEgg.astro";
import PerformanceProfile from "@/core/PerformanceProfile.astro";
import SeoMeta from "@/core/SeoMeta.astro";
import { getCanonicalPath, getThemePath } from "@/core/themes/registry";
import { lumenAssets } from "../assets";
import MangaRuntime from "../components/MangaRuntime.astro";
import SakuraRain from "../components/SakuraRain.astro";

// Props：这个布局组件接收的外部参数。所有字段都是可选的，不传就用下面的默认值。
// 想让某个页面改标题/描述/文章信息，就在那个页面的 <BaseLayout ... /> 上传对应属性。
interface Props {
  title?: string;
  description?: string;
  honorThemePreference?: boolean;
  redirectThemedNotFound?: boolean;
  isArticlePage?: boolean;
  article?: BlogPost["data"];
  stylesheets?: string[];
}

const {
  title = site.title,
  description = site.description,
  honorThemePreference = true,
  redirectThemedNotFound = false,
  isArticlePage = false,
  article,
  stylesheets = []
} = Astro.props;
// canonicalPath / canonical：规范化后的页面路径与完整网址，写入 <link rel="canonical"> 供 SEO 使用。
// canonicalPath 是不带 base 的规范路径（用于样式判断）；canonical 用 Astro.url（已含 base）构造，保证 SEO 网址正确。
const canonicalPath = getCanonicalPath(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.url);
// 主题首页路径：本主题挂在 /themes/lumen-kael-xystus/ 下，所有站内链接都要经 getThemePath 加前缀。
const themeHomePath = getThemePath("lumen-kael-xystus", "/");
// 导航项：把 site.nav 的每个链接都转换成带主题前缀的地址，否则会跳到默认主题。
const navItems = site.nav.map((item) => ({
  ...item,
  href: getThemePath("lumen-kael-xystus", item.href)
}));
// 是否处于「备选主题路由」（路径含 /themes/ 段）：这类页面会被搜索引擎忽略，避免重复收录。
// Astro.url.pathname 在子路径部署时带 base，用 pathname.includes 而非 startsWith 判定。
const isAlternateThemeRoute = Astro.url.pathname.includes("/themes/");
// 主题 404 重定向脚本：以字符串形式存放，配合下方 set:html 注入。
// 作用：访问本主题下不存在的地址时，跳到该主题的 /404/ 并带上原始地址参数。
// base 前缀由 frontmatter 注入，脚本内先剥离再匹配主题段，输出跳转路径时再加回。
const notFoundBase = import.meta.env.BASE_URL.replace(/\/$/, "");
const themedNotFoundRedirectScript = `(() => {
  const basePrefix = ${JSON.stringify(notFoundBase)};
  let pathname = window.location.pathname;
  if (basePrefix && pathname.startsWith(basePrefix + "/")) pathname = pathname.slice(basePrefix.length) || "/";
  const themeMatch = pathname.match(/^\\/themes\\/(lumen-kael-xystus)(?:\\/|$)/);
  if (!themeMatch) return;
  const themeId = themeMatch[1];
  const notFoundPath = basePrefix + "/themes/" + themeId + "/404/";
  if (window.location.pathname === notFoundPath) return;
  const original = window.location.pathname + window.location.search + window.location.hash;
  window.location.replace(notFoundPath + "?from=" + encodeURIComponent(original));
})();`;
---

<!doctype html>
<html lang="zh-CN">
  <!-- ============ <head> 区： meta、SEO、主题样式、图标 ============ -->
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- PerformanceProfile：读取性能档位（full/lite），脚本会据此决定是否加载重型动画。 -->
    <PerformanceProfile />
    <!-- SeoMeta：集中处理 title/description/canonical 与文章结构化数据。 -->
    <SeoMeta title={title} description={description} canonical={canonical} isArticlePage={isArticlePage} article={article} />
    <meta name="theme-color" content="#f6fbfa" />
    {isAlternateThemeRoute && <meta name="robots" content="noindex,follow" />}
    {
      redirectThemedNotFound && (
        <script is:inline set:html={themedNotFoundRedirectScript}></script>
      )
    }
    <link rel="canonical" href={canonical} />
    <!-- ThemePreferenceGate：在页面渲染前跑一小段脚本，尊重用户上次选的主题，避免闪屏。 -->
    <ThemePreferenceGate currentTheme="lumen-kael-xystus" honorPreference={honorThemePreference} />
    <link rel="icon" type="image/png" href={lumenAssets.favicon} />
    <link rel="apple-touch-icon" href={lumenAssets.appleTouchIcon} />
    <title>{title}</title>
    <!-- 条件加载样式：首页不加载这两个，其余页面才加载（?url 让 Vite 把 CSS 当资源返回 URL）。
         想让首页也用这些样式，就去掉 canonicalPath !== "/" 的判断。 -->
    {canonicalPath !== "/" && <link rel="stylesheet" href={refreshPagesHref} />}
    {canonicalPath !== "/" && <link rel="stylesheet" href={mangaPagesHref} />}
    <!-- 页面可额外传入自己的样式表（如 About/Projects 页），通过 stylesheets 属性追加。 -->
    {stylesheets.map((stylesheet) => <link rel="stylesheet" href={stylesheet} />)}
    <!-- ClientRouter：Astro 的「视图过渡」路由器，让页面切换不整页刷新（SPA 式），因此脚本要监听 astro:page-load 等事件。 -->
    <ClientRouter />
    <ConsoleEasterEgg />
  </head>
  <body
    data-lumenkaelxystus
    data-pagefind-ignore={isAlternateThemeRoute ? true : undefined}
    data-lunkey-selection-lock={isArticlePage ? undefined : "true"}
    data-lunkey-article-page={isArticlePage ? "true" : undefined}
  >
    <!-- ============ body 区 ============ -->
    <!-- 无障碍：键盘用户按 Tab 第一时间跳到正文，跳过导航。 -->
    <a class="skip-to-content" href="#page-content">跳至正文</a>
    <!-- 樱花雨背景装饰：纯 CSS 动画（见 components/SakuraRain.astro）。 -->
    <SakuraRain />
    <!-- 趣味滚动条：小猪跟着页面滚动进度移动，进度由下方脚本的 --scroll-progress 等变量驱动。 -->
    <div class="pig-scrollbar" data-pig-scrollbar aria-hidden="true">
      <div class="pig-scrollbar-track">
        <div class="pig-scrollbar-fill"></div>
      </div>
      <div class="pig-scrollbar-pig">
        <span class="pig-scrollbar-snort">哼~ 哼~</span>
        <img src={lumenAssets.scrollPig} alt="" width="56" height="48" />
      </div>
    </div>
    <!-- 玩具坞（右下角工具面板）：内含 Live2D 看板娘控制 + 音乐播放器两个小组件。
         transition:persist 让它在页面切换时保持状态不重建；展开/收起逻辑在下方脚本的 toyDock 部分。 -->
    <aside class="toy-dock" aria-label="Lumen Kael Xystus toy dock" transition:persist="lunkey-toy-dock">
      <button class="toy-dock-handle" type="button" aria-label="打开音乐与看板娘工具" title="音乐与看板娘" aria-expanded="false" aria-controls="toy-dock-panel">
        <Icon name="tabler:sparkles" aria-hidden="true" />
      </button>
      <div class="toy-dock-panel" id="toy-dock-panel">
        <!-- 看板娘控制卡：状态文字、显示/隐藏按钮、说句话按钮，data-* 属性供脚本查询绑定事件。 -->
        <section class="toy-widget live2d-control-widget" aria-label="Live2D 看板娘控制">
          <div class="toy-widget-title">
            <span><Icon name="tabler:sparkles" aria-hidden="true" /></span>
            <strong>Live2D 控制台</strong>
          </div>
          <p class="live2d-status" data-live2d-status>正在唤醒看板娘...</p>
          <div class="live2d-controls">
            <button type="button" data-live2d-toggle>隐藏看板娘</button>
            <button type="button" data-live2d-message>说句话</button>
          </div>
        </section>

        <!-- 音乐播放器卡：黑胶封面、进度条、上一首/播放/下一首、音量。歌单来自 music/manifest.json，逻辑见下方 createlunkeyRadio。 -->
        <section class="toy-widget music-widget" aria-label="音乐播放器">
          <div class="toy-widget-title">
            <span>♫</span>
            <strong>L·K·X Radio</strong>
          </div>
          <div class="music-player-shell">
            <div class="music-cover-area">
              <div class="record-player" aria-hidden="true">
                <div class="record-arm"></div>
                <div class="record-disc">
                  <div class="record-label">
                    <img src={lumenAssets.brand} alt="" width="42" height="38" />
                  </div>
                </div>
              </div>
              <span class="music-cover-caption" data-music-status>待播放</span>
            </div>
            <div class="music-info-area">
              <span class="music-meta">Lumen playlist</span>
              <p class="music-track">lofi sakura loop</p>
              <p class="music-note" data-music-note>正在读取歌单...</p>
            </div>
          </div>
          <div class="music-progress">
            <div class="music-control-label">
              <span>播放进度</span>
              <strong><span data-music-current>00:00</span> / <span data-music-duration>00:00</span></strong>
            </div>
            <input data-music-seek type="range" min="0" max="100" value="0" step="0.1" aria-label="播放进度" />
          </div>
          <div class="music-bottom-row">
            <div class="music-controls" aria-label="播放控制">
              <button type="button" data-music-prev aria-label="上一首" title="上一首"><Icon name="tabler:player-skip-forward" aria-hidden="true" /></button>
              <button type="button" data-music-toggle aria-label="播放音乐" title="播放音乐" aria-pressed="false">
                <Icon class="music-play-icon" name="tabler:player-play" aria-hidden="true" />
                <Icon class="music-pause-icon" name="tabler:player-pause" aria-hidden="true" />
              </button>
              <button type="button" data-music-next aria-label="下一首" title="下一首"><Icon name="tabler:player-skip-forward" aria-hidden="true" /></button>
            </div>
            <div class="music-volume">
              <div class="music-control-label">
                <span>音量</span>
                <strong data-music-volume-label>28%</strong>
              </div>
              <input data-music-volume type="range" min="0" max="1" value="0.28" step="0.01" aria-label="音量" />
            </div>
          </div>
        </section>

      </div>
    </aside>
    <!-- 自定义右键菜单：替代浏览器原生菜单，含回到顶部/刷新/复制/切换樱花雨/切换主题等按钮。
         右键弹出、点击外部关闭、各按钮行为都在下方脚本的 contextMenu 部分。 -->
    <nav class="custom-context-menu" data-context-menu aria-label="&#x5FEB;&#x6377;&#x83DC;&#x5355;">
      <button type="button" data-context-action="top">&#x2191; &#x56DE;&#x5230;&#x9876;&#x90E8;</button>
      <button type="button" data-context-action="refresh">&#x21BB; &#x5237;&#x65B0;&#x9875;&#x9762;</button>
      <button type="button" data-context-action="home">&#x2302; &#x8FD4;&#x56DE;&#x9996;&#x9875;</button>
      <button type="button" data-context-action="back">&#x2190; &#x540E;&#x9000;</button>
      <button type="button" data-context-action="forward">&#x2192; &#x524D;&#x8FDB;</button>
      <button type="button" data-context-action="copy">&#x29C9; &#x590D;&#x5236;&#x94FE;&#x63A5;</button>
      <button type="button" data-context-action="title">T &#x590D;&#x5236;&#x6807;&#x9898;</button>
      <button type="button" data-context-action="sakura" aria-pressed="true">&#x273F; 樱花雨：开</button>
      <button type="button" data-context-action="music-autoplay" aria-pressed="false">♫ 进站续播：关</button>
      <div class="context-theme-group" aria-label="选择前端主题">
        <span class="context-theme-label">THEME</span>
        <button type="button" data-theme-select="lumen-kael-xystus" aria-pressed="true">
          <span class="context-theme-mark" aria-hidden="true">●</span>
          Lumen Kael Xystus
        </button>
        <button type="button" data-theme-select="flcl" aria-pressed="false">
          <span class="context-theme-mark" aria-hidden="true">○</span>
          FLCL
        </button>
      </div>
    </nav>
    <!-- ============ 站点主体外壳：header 导航 + <main> 内容插槽 + footer ============ -->
    <div class="site-shell">
      <!-- 全站顶部导航：Logo + 由 navItems.map 生成的导航链接；aria-current 标记当前所在页。 -->
      <header class="site-header" aria-label="Primary">
        <a class="brand" href={themeHomePath} aria-label={`${site.name} home`}>
          <img src={lumenAssets.brand} alt="" width="40" height="36" />
          <span>{site.name}</span>
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          <!-- map 循环：把 navItems 数组渲染成一排导航链接。想增删导航项，改 lib/site.ts 里的 site.nav。 -->
          {
            navItems.map((item) => (
              <a href={item.href} aria-label={`${item.label}: ${item.hint}`} aria-current={(item.href === themeHomePath ? Astro.url.pathname === item.href : Astro.url.pathname.startsWith(item.href)) ? "page" : undefined}>
                <span class="nav-icon" aria-hidden="true"><Icon name={item.icon} /></span>
                <span class="nav-label">{item.label}</span>
                <span class="nav-hint">{item.hint}</span>
              </a>
            ))
          }
        </nav>
      </header>
      <!-- ★核心插槽★：所有页面的具体内容都从这里注入（Astro 的 slot 概念）。
           BaseLayout 只提供外壳，真正的页面内容由各 pages/*.astro 写在 <BaseLayout>...</BaseLayout> 之间。
           id="page-content" 对应上面的「跳至正文」链接；tabindex="-1" 让脚本可聚焦它。 -->
      <main id="page-content" tabindex="-1">
        <slot />
      </main>
      <!-- 页脚：data-footer-timers 标记的 <time> 会被下方脚本实时计算「过去了多久」并填入。 -->
      <footer class="site-footer" data-footer-timers>
        <div class="footer-inner">
          <p class="footer-signature-line">© 2026 BY Lunkey / Lumen Kael Xystus</p>
          <p>二次元手账、开发记录、还有一点点宇宙回声。</p>
          <p>✦ Lumen Kael Xystus 已落地：<time data-elapsed-from="2026-05-18T00:00:00+08:00" data-elapsed-mode="second">计算中...</time></p>
          <p>✦ vitrual world 开发中: <time data-elapsed-from="2026-05-18T00:00:00+08:00" data-elapsed-mode="minute">计算中...</time></p>
          <p>✦ galgame 持续推进: <time data-elapsed-from="2022-06-01T00:00:00+08:00" data-elapsed-mode="second">计算中...  </time></p>
          <p> 素材来源于p站 </p>
        </div>
      </footer>
    </div>
    <!-- 长按主题切换菜单 / 漫画场景与相册等运行时（ Mount 各类交互，见对应组件）。 -->
    <ThemeLongPressMenu />
    <MangaRuntime />

    <!-- ============ 内联 <script> 区：全站交互逻辑（Astro 会打包，类型安全） ============
         因为启用了 ClientRouter 视图过渡，脚本普遍监听 astro:page-load / astro:before-swap 等事件来初始化与清理。 -->
    <script>
      import { createLive2dReactions } from "../lib/live2d-input.mjs";
      import { mountWaifuAnchor } from "../lib/waifu-anchor.mjs";

      // ---------- 区块 1：趣味滚动条（小猪 + 进度） ----------
      let pigScrollTimer = 0;
      let pigScrollFrame = 0;

      // 读取滚动进度，写入 CSS 变量（--scroll-progress 等），样式层据此移动小猪。
      const updatePigScrollbar = () => {
        const pigScrollbar = document.querySelector("[data-pig-scrollbar]");
        if (!pigScrollbar) return;

        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
        const track = pigScrollbar.querySelector(".pig-scrollbar-track");
        const trackHeight = track?.getBoundingClientRect().height ?? 0;
        const pigY = 20 + progress * trackHeight;
        pigScrollbar.style.setProperty("--scroll-progress", `${Math.min(1, Math.max(0, progress))}`);
        pigScrollbar.style.setProperty("--scroll-percent", `${Math.min(1, Math.max(0, progress)) * 100}%`);
        pigScrollbar.style.setProperty("--pig-y", `${pigY}px`);
        pigScrollbar.classList.add("is-moving");
        window.clearTimeout(pigScrollTimer);
        pigScrollTimer = window.setTimeout(() => {
          pigScrollbar.classList.remove("is-moving");
        }, 260);
      };

      const schedulePigScrollbar = () => {
        if (pigScrollFrame) return;
        pigScrollFrame = window.requestAnimationFrame(() => {
          pigScrollFrame = 0;
          updatePigScrollbar();
        });
      };

      // requestAnimationFrame 把多次滚动事件合并到下一帧，避免频繁计算造成卡顿。
      // passive:true 告诉浏览器本监听不会阻止默认滚动，提升滚动性能。
      schedulePigScrollbar();
      window.addEventListener("scroll", schedulePigScrollbar, { passive: true });
      window.addEventListener("resize", schedulePigScrollbar);
      document.addEventListener("astro:page-load", schedulePigScrollbar);
      document.addEventListener("astro:after-swap", schedulePigScrollbar);
      window.addEventListener("pageshow", schedulePigScrollbar);

      // ---------- 区块 2：页脚计时器（旅行者一号等「已落地多久」） ----------
      // padTimer：把 1 补成 "01"，让时间显示统一两位。
      const padTimer = (value) => String(value).padStart(2, "0");
      // getElapsedParts：把「起始时间到现在」的毫秒差拆成天/时/分/秒。
      const getElapsedParts = (startDate) => {
        const diff = Math.max(0, Date.now() - startDate.getTime());
        const totalSeconds = Math.floor(diff / 1000);
        return {
          days: Math.floor(totalSeconds / 86400),
          hours: Math.floor((totalSeconds % 86400) / 3600),
          minutes: Math.floor((totalSeconds % 3600) / 60),
          seconds: totalSeconds % 60
        };
      };

      const formatElapsed = (startDate, mode = "second") => {
        const { days, hours, minutes, seconds } = getElapsedParts(startDate);
        if (mode === "minute") {
          return `${days.toLocaleString("zh-CN")}天 ${padTimer(hours)}小时 ${padTimer(minutes)}分`;
        }
        if (mode === "days") {
          return `第 ${days.toLocaleString("zh-CN")} 天`;
        }
        return `${days.toLocaleString("zh-CN")}天 ${padTimer(hours)}小时 ${padTimer(minutes)}分 ${padTimer(seconds)}秒`;
      };

      // 遍历所有 data-elapsed-from 节点，按各自的 data-elapsed-mode（minute/days/second）格式化后写入。
      const updateFooterTimers = () => {
        const timerNodes = document.querySelectorAll("[data-elapsed-from]");
        timerNodes.forEach((node) => {
          const start = new Date(node.dataset.elapsedFrom);
          if (Number.isNaN(start.getTime())) return;
          node.textContent = formatElapsed(start, node.dataset.elapsedMode);
          node.setAttribute("dateTime", start.toISOString());
        });
      };

      let footerTimer = 0;
      const scheduleFooterTimers = () => {
        if (footerTimer) window.clearTimeout(footerTimer);
        footerTimer = 0;
        if (document.visibilityState !== "visible") return;
        updateFooterTimers();
        footerTimer = window.setTimeout(scheduleFooterTimers, 1000);
      };

      scheduleFooterTimers();
      document.addEventListener("astro:page-load", updateFooterTimers);
      document.addEventListener("astro:after-swap", updateFooterTimers);
      window.addEventListener("pageshow", updateFooterTimers);
      document.addEventListener("visibilitychange", scheduleFooterTimers);

      // ---------- 区块 3：玩具坞展开/收起（点击固定、悬停、聚焦、点外部关闭、Esc 关闭） ----------
      let toyDockCloseTimer = 0;
      const getToyDock = () => document.querySelector(".toy-dock");
      const syncToyDock = () => {
        const toyDock = getToyDock();
        if (!toyDock) return;
        const open = !toyDock.classList.contains("is-dismissed")
          && (toyDock.classList.contains("is-pinned") || toyDock.matches(":hover, :focus-within"));
        const handle = toyDock.querySelector(".toy-dock-handle");
        handle?.setAttribute("aria-expanded", String(open));
        handle?.setAttribute("aria-label", open ? "收起音乐与看板娘工具" : "打开音乐与看板娘工具");
      };
      const dismissToyDock = () => {
        const toyDock = getToyDock();
        if (!toyDock) return;
        toyDock.classList.remove("is-pinned");
        toyDock.classList.add("is-dismissed");
        toyDock.querySelector(":focus")?.blur();
        syncToyDock();
      };
      const isInsideToyDock = (target) => {
        const toyDock = getToyDock();
        return Boolean(toyDock && target instanceof Node && toyDock.contains(target));
      };
      document.addEventListener("click", (event) => {
        const handle = event.target instanceof Element ? event.target.closest(".toy-dock-handle") : null;
        if (!handle) return;
        const toyDock = getToyDock();
        if (!toyDock) return;
        const pinned = toyDock.classList.toggle("is-pinned");
        toyDock.classList.toggle("is-dismissed", !pinned);
        if (!pinned) handle.blur();
        syncToyDock();
      });
      document.addEventListener("pointerover", (event) => {
        if (!isInsideToyDock(event.target) || isInsideToyDock(event.relatedTarget)) return;
        window.clearTimeout(toyDockCloseTimer);
        getToyDock()?.classList.remove("is-dismissed");
        syncToyDock();
      });
      document.addEventListener("pointerout", (event) => {
        if (!isInsideToyDock(event.target) || isInsideToyDock(event.relatedTarget)) return;
        const toyDock = getToyDock();
        if (!toyDock) return;
        if (toyDock.classList.contains("is-pinned")) return;
        toyDockCloseTimer = window.setTimeout(() => {
          toyDock.querySelector(":focus")?.blur();
          syncToyDock();
        }, 180);
      });
      document.addEventListener("focusin", (event) => {
        if (!isInsideToyDock(event.target)) return;
        getToyDock()?.classList.remove("is-dismissed");
        syncToyDock();
      });
      document.addEventListener("focusout", () => queueMicrotask(syncToyDock));
      window.addEventListener("pointerdown", (event) => {
        const toyDock = getToyDock();
        if (!toyDock || toyDock.contains(event.target)) return;
        dismissToyDock();
      });
      window.addEventListener("keydown", (event) => {
        const toyDock = getToyDock();
        if (event.key !== "Escape" || !toyDock) return;
        dismissToyDock();
      });
      document.addEventListener("astro:before-swap", dismissToyDock);
      document.addEventListener("astro:page-load", syncToyDock);

      // ---------- 区块 4：Live2D 看板娘 ----------
      // 只在首页加载：从 CDN 动态注入 waifu.css / waifu-tips.js，空闲时初始化，失败则用本地图片兜底。
      // live2dGeneration 是「代号」，页面切换时自增，用来丢弃过期的异步回调，避免竞态。
      const live2dBase = "https://fastly.jsdelivr.net/npm/live2d-widgets@1.0.0-rc.6/dist/";
      const live2dConfig = "/themes/lumen-kael-xystus/RUKI/waifu-tips.json";
      const live2dStatus = document.querySelector("[data-live2d-status]");
      const live2dToggle = document.querySelector("[data-live2d-toggle]");
      const live2dMessage = document.querySelector("[data-live2d-message]");
      const live2dWidget = live2dStatus?.closest(".live2d-control-widget");
      const live2dControls = [live2dToggle, live2dMessage].filter(Boolean);
      let live2dVisible = true;
      let live2dReady = false;
      let live2dInitStarted = false;
      let live2dIdleHandle = 0;
      let live2dFallbackTimer = 0;
      let live2dVisibilityTimer = 0;
      let live2dGeneration = 0;
      let waifuAnchorCleanup = null;
      let live2dReactions = null;
      const live2dConnection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      const live2dResources = new Map();
      const anchorWaifu = (waifu) => {
        waifuAnchorCleanup?.();
        waifuAnchorCleanup = mountWaifuAnchor(waifu);
        live2dReactions?.stop();
        const canvas = document.getElementById("live2d");
        live2dReactions?.start(waifu, canvas);
      };

      const setLive2dStatus = (text) => {
        if (live2dStatus) live2dStatus.textContent = text;
      };

      const isHomeRoute = () => {
        // 剥离 base 后再判断，兼容 GitHub Pages 子路径部署。
        const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, "");
        let path = window.location.pathname.replace(/\/index\.html$/, "/");
        if (basePrefix && path.startsWith(basePrefix + "/")) path = path.slice(basePrefix.length) || "/";
        if (basePrefix && path === basePrefix) path = "/";
        return path === "/" || path === "/themes/lumen-kael-xystus/" || path === "/themes/lumen-kael-xystus";
      };

      const setLive2dControlsLocked = (locked) => {
        live2dWidget?.classList.toggle("is-route-locked", locked);
        live2dControls.forEach((button) => {
          button.disabled = locked;
          button.setAttribute("aria-disabled", String(locked));
        });
        if (locked) {
          if (live2dToggle) live2dToggle.textContent = "仅首页可用";
          setLive2dStatus("看板娘只在首页出现，阅读页先让出视野。");
        }
      };

      const hasLive2dWidget = () => {
        const waifu = document.getElementById("waifu");
        const canvas = document.getElementById("live2d");
        if (!waifu || !canvas) return false;
        const canvasRect = canvas.getBoundingClientRect();
        return canvasRect.width > 80 && canvasRect.height > 80;
      };

      const removeLive2dWidget = () => {
        live2dGeneration++;
        window.clearTimeout(live2dVisibilityTimer);
        waifuAnchorCleanup?.();
        waifuAnchorCleanup = null;
        live2dReactions?.stop();
        removeLocalWaifuFallback();
        document.getElementById("waifu")?.remove();
        document.getElementById("waifu-toggle")?.remove();
        document.getElementById("waifu-tool")?.remove();
        live2dReady = false;
        live2dInitStarted = false;
        live2dVisible = false;
      };

      const resetLive2dStorage = () => {
        localStorage.removeItem("waifu-display");
        localStorage.setItem("modelId", "0");
        localStorage.setItem("modelTexturesId", "0");
      };

      const clearLive2dSchedule = () => {
        if (live2dIdleHandle && window.cancelIdleCallback) window.cancelIdleCallback(live2dIdleHandle);
        if (live2dFallbackTimer) window.clearTimeout(live2dFallbackTimer);
        live2dIdleHandle = 0;
        live2dFallbackTimer = 0;
      };

      const canAutoInitLive2d = () => {
        const profile = document.documentElement.dataset.lunkeyPerformance ?? "full";
        const effectiveType = String(live2dConnection?.effectiveType || "").toLowerCase();
        return profile === "full"
          && !live2dConnection?.saveData
          && !/(^|-)2g$/.test(effectiveType);
      };

      // 动态加载外部 CSS/JS 并去重：用 Map 缓存同一个 URL 的 Promise，避免重复请求。
      // 用 new Function 动态创建 script 标签，是因为打包器不会静态分析这些 CDN 字符串。
      const loadExternalResource = (url, type) => {
        const existing = Array.from(document.head.querySelectorAll("link[href], script[src]"))
          .find((element) => element.href === url || element.src === url);
        if (existing) return live2dResources.get(url) ?? Promise.resolve(url);

        // Astro may discard a dynamically injected head node on a route swap.
        live2dResources.delete(url);
        const tag = type === "css" ? document.createElement("link") : document.createElement("script");
        const promise = new Promise((resolve, reject) => {
          if (type === "css") {
            tag.rel = "stylesheet";
            tag.href = url;
          } else {
            tag.type = "module";
            tag.src = url;
          }
          tag.onload = () => resolve(url);
          tag.onerror = () => reject(url);
          document.head.appendChild(tag);
        }).catch((error) => {
          if (live2dResources.get(url) === promise) live2dResources.delete(url);
          tag.remove();
          throw error;
        });

        live2dResources.set(url, promise);
        return promise;
      };

      const setWaifuVisibility = (visible, options = {}) => {
        const { persist = true } = options;
        const waifu = document.getElementById("waifu");
        window.clearTimeout(live2dVisibilityTimer);
        live2dVisible = visible;
        if (live2dToggle) live2dToggle.textContent = visible ? "隐藏看板娘" : "显示看板娘";
        setLive2dStatus(visible ? "看板娘正在左侧待机。" : "看板娘已收起。");
        if (visible) {
          if (persist) localStorage.removeItem("waifu-display");
        }
        if (!waifu) return;

        if (visible) {
          waifu.classList.remove("waifu-hidden");
          waifu.classList.add("waifu-active");
          anchorWaifu(waifu);
        } else {
          waifu.classList.remove("waifu-active");
          if (persist) localStorage.setItem("waifu-display", Date.now().toString());
          live2dVisibilityTimer = window.setTimeout(() => waifu.classList.add("waifu-hidden"), 180);
          live2dReactions?.stop();
        }
      };

      const showWaifuMessage = (message) => {
        const tips = document.getElementById("waifu-tips");
        if (!tips) return;
        tips.innerHTML = message;
        tips.classList.add("waifu-tips-active");
        window.setTimeout(() => tips.classList.remove("waifu-tips-active"), 4200);
      };

      const waitForWaifu = (callback, retries = 30, generation = live2dGeneration) => {
        if (generation !== live2dGeneration || !isHomeRoute()) return;
        const waifu = document.getElementById("waifu");
        if (waifu) {
          callback(waifu);
          return;
        }
        if (retries <= 0) return;
        window.setTimeout(() => waitForWaifu(callback, retries - 1, generation), 300);
      };

      const ensureLocalWaifuFallback = () => {
        if (!isHomeRoute()) return;
        if (document.querySelector(".waifu-local-fallback")) return;
        const fallback = document.createElement("div");
        fallback.className = "waifu-local-fallback";
        fallback.setAttribute("aria-label", "Lumen Kael Xystus fallback 看板娘");
        fallback.innerHTML = `
          <div class="waifu-local-bubble">Live2D 加载有点害羞，先由我值班。</div>
          <div class="waifu-local-character">
            <img src="${import.meta.env.BASE_URL}themes/lumen-kael-xystus/assets/profile.webp" alt="" width="128" height="128" />
          </div>
        `;
        document.body.appendChild(fallback);
      };

      const removeLocalWaifuFallback = () => {
        document.querySelector(".waifu-local-fallback")?.remove();
      };

      const activateWaifuFallbackIfBlank = () => {
        if (!isHomeRoute()) {
          removeLocalWaifuFallback();
          return;
        }
        const waifu = document.getElementById("waifu");
        const canvas = document.getElementById("live2d");
        if (!waifu || !canvas || waifu.classList.contains("waifu-hidden")) return;
        const canvasRect = canvas.getBoundingClientRect();
        const hasUsableCanvas = canvasRect.width > 80 && canvasRect.height > 80;
        const hasWidgetTools = Boolean(document.getElementById("waifu-tool"));
        if (hasUsableCanvas && hasWidgetTools) {
          removeLocalWaifuFallback();
          setLive2dStatus("看板娘正在左侧待机。");
          return;
        }
        ensureLocalWaifuFallback();
        setLive2dStatus("Live2D 本体加载不稳定，已启用本地看板娘备用显示。");
      };

      const reconcileWaifuFallback = () => {
        if (!isHomeRoute()) {
          removeLocalWaifuFallback();
          return;
        }
        const waifu = document.getElementById("waifu");
        const canvas = document.getElementById("live2d");
        if (!waifu || !canvas || waifu.classList.contains("waifu-hidden")) return;
        const canvasRect = canvas.getBoundingClientRect();
        if (canvasRect.width > 80 && canvasRect.height > 80) {
          removeLocalWaifuFallback();
          setLive2dStatus("看板娘正在左侧待机。");
        }
      };

      // 真正初始化看板娘：并行加载 CSS 与 tips 脚本，动态 import 表情控制器，再调用 window.initWidget 生成挂件。
      const initLive2dWidget = async () => {
        if (!isHomeRoute()) return;
        clearLive2dSchedule();
        if (hasLive2dWidget()) {
          void loadExternalResource(`${live2dBase}waifu.css`, "css").catch(() => {});
          live2dReady = true;
          live2dInitStarted = false;
          setWaifuVisibility(true, { persist: false });
          return;
        }
        if (live2dInitStarted) return;
        live2dInitStarted = true;
        const generation = ++live2dGeneration;
        try {
          resetLive2dStorage();
          setLive2dControlsLocked(false);
          await Promise.all([
            loadExternalResource(`${live2dBase}waifu.css`, "css"),
            typeof window.initWidget === "function" ? Promise.resolve() : loadExternalResource(`${live2dBase}waifu-tips.js`, "js")
          ]);
          if (generation !== live2dGeneration || !isHomeRoute()) return;
          if (!live2dReactions) {
            try {
              const { AppDelegate } = await import(/* @vite-ignore */ `${live2dBase}chunk/index2.js`);
              if (generation !== live2dGeneration || !isHomeRoute()) return;
              live2dReactions = createLive2dReactions(AppDelegate);
            } catch (error) {
              console.warn("[lunkey Live2D] Expression controller unavailable.", error);
            }
          }
          window.initWidget({
            waifuPath: live2dConfig,
            cubism2Path: `${live2dBase}live2d.min.js`,
            cubism5Path: "https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js",
            tools: ["photo", "quit"],
            logLevel: "warn",
            drag: false
          });
          live2dReady = true;
          live2dVisible = true;
          if (live2dToggle) live2dToggle.textContent = "隐藏看板娘";
          setLive2dStatus("看板娘正在左侧待机。");
          waitForWaifu((waifu) => {
            const size = Math.min(280, Math.max(220, window.innerHeight - 64), Math.max(220, window.innerWidth - 32));
            const canvas = waifu.querySelector("#live2d");
            const canvasWrap = waifu.querySelector("#waifu-canvas");
            waifu.style.width = `${size}px`;
            waifu.style.height = `${size}px`;
            if (canvasWrap) {
              canvasWrap.style.width = `${size}px`;
              canvasWrap.style.height = `${size}px`;
            }
            if (canvas instanceof HTMLCanvasElement) {
              canvas.style.width = `${size}px`;
              canvas.style.height = `${size}px`;
              canvas.width = 800;
              canvas.height = 800;
            }
            waifu.classList.remove("waifu-hidden", "waifu-awaiting-render");
            waifu.classList.add("waifu-active", "waifu-render-ready");
            removeLocalWaifuFallback();
            anchorWaifu(waifu);
            window.setTimeout(() => showWaifuMessage("欢迎来到 Lumen Kael Xystus，今天也要开心写代码。"), 900);
            window.setTimeout(reconcileWaifuFallback, 4200);
            window.setTimeout(activateWaifuFallbackIfBlank, 12000);
          });
        } catch (error) {
          if (generation !== live2dGeneration || !isHomeRoute()) return;
          live2dInitStarted = false;
          ensureLocalWaifuFallback();
          setLive2dStatus("看板娘加载失败，请检查网络。");
        }
      };

      const scheduleLive2dWidget = () => {
        clearLive2dSchedule();
        if (!isHomeRoute() || live2dReady || live2dInitStarted || hasLive2dWidget()) return;
        if (live2dToggle) live2dToggle.textContent = "显示看板娘";
        if (!canAutoInitLive2d()) {
          setLive2dStatus("点击“显示看板娘”后再加载 Live2D。");
          return;
        }

        setLive2dStatus("看板娘会在页面空闲后出现。");
        const start = () => {
          live2dIdleHandle = 0;
          live2dFallbackTimer = 0;
          void initLive2dWidget();
        };
        if (window.requestIdleCallback) {
          live2dIdleHandle = window.requestIdleCallback(start, { timeout: 3200 });
        } else {
          live2dFallbackTimer = window.setTimeout(start, 1600);
        }
      };

      const hardReloadLive2d = () => {
        if (!isHomeRoute()) return;
        removeLive2dWidget();
        resetLive2dStorage();
        initLive2dWidget();
      };

      const hideLive2dForRoute = () => {
        live2dGeneration++;
        window.clearTimeout(live2dVisibilityTimer);
        waifuAnchorCleanup?.();
        waifuAnchorCleanup = null;
        live2dReactions?.stop();
        clearLive2dSchedule();
        removeLocalWaifuFallback();
        const waifu = document.getElementById("waifu");
        if (waifu) {
          waifu.classList.remove("waifu-active");
          waifu.classList.add("waifu-hidden");
        }
        live2dInitStarted = false;
        live2dVisible = false;
      };

      // 路由变化时同步看板娘状态：非首页隐藏并锁定按钮；首页则视情况重载或调度加载。
      const syncLive2dRouteState = () => {
        if (!isHomeRoute()) {
          hideLive2dForRoute();
          setLive2dControlsLocked(true);
          return;
        }

        setLive2dControlsLocked(false);
        if (hasLive2dWidget()) {
          void loadExternalResource(`${live2dBase}waifu.css`, "css").catch(() => {});
          setWaifuVisibility(true, { persist: false });
          window.setTimeout(reconcileWaifuFallback, 800);
          return;
        }
        if (document.getElementById("waifu")) {
          hardReloadLive2d();
          return;
        }
        live2dReady = false;
        live2dInitStarted = false;
        scheduleLive2dWidget();
      };

      syncLive2dRouteState();
      document.addEventListener("astro:page-load", syncLive2dRouteState);
      document.addEventListener("astro:after-swap", syncLive2dRouteState);
      document.addEventListener("astro:before-swap", hideLive2dForRoute);
      window.addEventListener("pageshow", syncLive2dRouteState);
      window.addEventListener("pagehide", clearLive2dSchedule);

      live2dToggle?.addEventListener("click", () => {
        if (!isHomeRoute()) return;
        if (!live2dReady && !document.getElementById("waifu")) {
          initLive2dWidget();
          return;
        }
        if (live2dVisible && document.getElementById("waifu") && !document.getElementById("live2d")) {
          hardReloadLive2d();
          return;
        }
        setWaifuVisibility(!live2dVisible);
      });
      live2dMessage?.addEventListener("click", () => {
        if (!isHomeRoute()) return;
        setWaifuVisibility(true);
        waitForWaifu((waifu) => waifu.classList.add("waifu-active"));
        window.setTimeout(reconcileWaifuFallback, 800);
        showWaifuMessage("我在这里。要不要继续给博客堆一点可爱的功能？");
      });
      // ---------- 区块 5：音乐播放器（L·K·X Radio） ----------
      // 用 localStorage 记住播放进度/音量/自动播放开关；用 AbortController 统一解绑事件，避免页面切换后重复绑定。
      // createlunkeyRadio 返回一个 player 对象，挂到 window.__lunkeyRadio 上供右键菜单等共享调用。
      const musicCacheKey = "lunkey-radio-state-v1";
      const musicAutoplayKey = "lunkey-radio-autoplay-v1";
      const musicSessionAutoplayKey = "lunkey-radio-session-autoplay-v1";
      const createlunkeyRadio = () => {
        const audio = new Audio();
        const player = {
          audio,
          tracks: [],
          index: 0,
          seeking: false,
          initialized: false,
          restoreAutoplay: false,
          pendingAutoplay: false,
          elements: {},
          controlAbort: null,
          audioAbort: null,
          unlockAbort: null
        };

        const formatAudioTime = (seconds) => {
          if (!Number.isFinite(seconds)) return "00:00";
          const minute = Math.floor(seconds / 60);
          const second = Math.floor(seconds % 60);
          return `${String(minute).padStart(2, "0")}:${String(second).padStart(2, "0")}`;
        };

        const getMusicState = () => {
          try {
            return JSON.parse(localStorage.getItem(musicCacheKey) ?? "{}");
          } catch {
            return {};
          }
        };

        const isMusicAutoplayEnabled = () => localStorage.getItem(musicAutoplayKey) === "1";
        const isMusicSessionAutoplayEnabled = () => sessionStorage.getItem(musicSessionAutoplayKey) === "1";
        const setMusicSessionAutoplayEnabled = (enabled) => {
          sessionStorage.setItem(musicSessionAutoplayKey, enabled ? "1" : "0");
        };

        const setMusicAutoplayEnabled = (enabled) => {
          localStorage.setItem(musicAutoplayKey, enabled ? "1" : "0");
          window.dispatchEvent(new CustomEvent("lunkey:music-autoplay-change", { detail: { enabled } }));
        };

        const clampVolume = (value, fallback = 0.28) => {
          const volume = Number(value);
          if (!Number.isFinite(volume)) return fallback;
          return Math.min(1, Math.max(0, volume));
        };

        const saveMusicState = () => {
          const currentTrack = player.tracks[player.index];
          if (!currentTrack) return;
          localStorage.setItem(
            musicCacheKey,
            JSON.stringify({
              trackId: currentTrack.id,
              currentTime: audio.currentTime || 0,
              volume: audio.volume,
              paused: player.pendingAutoplay ? false : audio.paused,
              updatedAt: Date.now()
            })
          );
        };

        // 用 data-* 属性集中查询播放器 DOM，存进 player.elements，后续统一取用。
        // 想改按钮对应关系，改这里的查询选择器 + 上面 HTML 里的 data 属性。
        const queryElements = () => {
          player.elements = {
            toggle: document.querySelector("[data-music-toggle]"),
            prev: document.querySelector("[data-music-prev]"),
            next: document.querySelector("[data-music-next]"),
            volume: document.querySelector("[data-music-volume]"),
            seek: document.querySelector("[data-music-seek]"),
            track: document.querySelector(".music-track"),
            current: document.querySelector("[data-music-current]"),
            duration: document.querySelector("[data-music-duration]"),
            note: document.querySelector("[data-music-note]"),
            status: document.querySelector("[data-music-status]"),
            volumeLabel: document.querySelector("[data-music-volume-label]")
          };
        };

        const updateMusicUi = () => {
          queryElements();
          const { toggle, volume, seek, track, current, duration, note, status, volumeLabel } = player.elements;
          const currentTrack = player.tracks[player.index];
          if (track) track.textContent = currentTrack?.title ?? "L·K·X Radio";
          if (current) current.textContent = formatAudioTime(audio.currentTime);
          if (duration) duration.textContent = formatAudioTime(audio.duration);
          if (seek && !player.seeking) {
            const progress = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
            seek.value = String(progress || 0);
          }
          if (seek) seek.style.setProperty("--range-fill", `${seek.value}%`);
          if (volume) {
            volume.value = String(audio.volume);
            volume.style.setProperty("--range-fill", `${audio.volume * 100}%`);
          }
          if (volumeLabel) volumeLabel.textContent = `${Math.round(audio.volume * 100)}%`;
          if (status) status.textContent = audio.paused ? "待播放" : "播放中";
          if (toggle) {
            toggle.setAttribute("aria-label", audio.paused ? "播放音乐" : "暂停音乐");
            toggle.setAttribute("title", audio.paused ? "播放音乐" : "暂停音乐");
            toggle.setAttribute("aria-pressed", String(!audio.paused));
          }
          if (note && player.tracks.length) note.textContent = `${player.index + 1} / ${player.tracks.length}`;
          document.body.classList.toggle("is-music-playing", !audio.paused);
        };

        const loadMusicTrack = (index, { keepTime = 0, autoplay = false, persist = true } = {}) => {
          if (!player.tracks.length) return;
          player.index = (index + player.tracks.length) % player.tracks.length;
          const track = player.tracks[player.index];
          const nextSrc = new URL(track.src, window.location.origin).href;
          if (audio.src !== nextSrc) {
            audio.src = track.src;
            audio.load();
          }
          const cached = getMusicState();
          audio.volume = Number.isFinite(cached.volume)
            ? clampVolume(cached.volume)
            : clampVolume(player.elements.volume?.value, audio.volume || 0.28);
          audio.addEventListener(
            "loadedmetadata",
            async () => {
              if (keepTime > 0 && keepTime < audio.duration - 1) audio.currentTime = keepTime;
              updateMusicUi();
              if (autoplay) {
                try {
                  await audio.play();
                  player.pendingAutoplay = false;
                } catch {
                  player.pendingAutoplay = true;
                  if (player.elements.note) player.elements.note.textContent = "浏览器需要你点一下播放。";
                }
                updateMusicUi();
              }
            },
            { once: true }
          );
          updateMusicUi();
          if (persist) saveMusicState();
        };

        // 拉取歌单 manifest.json，恢复上次的曲目/进度/音量；歌单为空时给出「请放入 MP3」提示。
        const initMusicPlayer = async () => {
          queryElements();
          if (player.initialized) {
            updateMusicUi();
            return;
          }

          try {
            const response = await fetch(`${import.meta.env.BASE_URL}themes/lumen-kael-xystus/music/manifest.json`, { cache: "no-cache" });
            player.tracks = await response.json();
          } catch {
            player.tracks = [];
          }

          if (!player.tracks.length) {
            if (player.elements.track) player.elements.track.textContent = "暂无歌曲";
            if (player.elements.note) player.elements.note.textContent = "请把 MP3 放入 MUSIC 文件夹。";
            return;
          }

          const cached = getMusicState();
          const cachedIndex = player.tracks.findIndex((track) => track.id === cached.trackId);
          player.index = cachedIndex >= 0 ? cachedIndex : 0;
          audio.volume = Number.isFinite(cached.volume) ? clampVolume(cached.volume) : clampVolume(player.elements.volume?.value);
          player.restoreAutoplay = cached.paused === false && (isMusicAutoplayEnabled() || isMusicSessionAutoplayEnabled());
          player.pendingAutoplay = player.restoreAutoplay;
          loadMusicTrack(player.index, {
            keepTime: Number(cached.currentTime ?? 0),
            autoplay: false,
            persist: false
          });
          if (player.restoreAutoplay && player.elements.note) {
            player.elements.note.textContent = "已恢复进度，点击播放继续。";
          }
          player.initialized = true;
        };

        player.bind = () => {
          queryElements();
          player.controlAbort?.abort();
          player.controlAbort = new AbortController();
          const listenerOptions = { signal: player.controlAbort.signal };

          player.elements.toggle?.addEventListener("click", async () => {
            if (!player.tracks.length) return;
            if (audio.paused) {
              try {
                await audio.play();
                setMusicSessionAutoplayEnabled(true);
                player.pendingAutoplay = false;
              } catch {
                player.pendingAutoplay = true;
                if (player.elements.note) player.elements.note.textContent = "浏览器拦截了自动播放，请再点一次。";
              }
            } else {
              audio.pause();
              setMusicSessionAutoplayEnabled(false);
              player.pendingAutoplay = false;
            }
            updateMusicUi();
            saveMusicState();
          }, listenerOptions);

          player.elements.prev?.addEventListener("click", () => {
            loadMusicTrack(player.index - 1, { autoplay: !audio.paused });
          }, listenerOptions);

          player.elements.next?.addEventListener("click", () => {
            loadMusicTrack(player.index + 1, { autoplay: !audio.paused });
          }, listenerOptions);

          player.elements.volume?.addEventListener("input", () => {
            audio.volume = Number(player.elements.volume.value);
            saveMusicState();
            updateMusicUi();
          }, listenerOptions);

          player.elements.seek?.addEventListener("input", () => {
            player.seeking = true;
            player.elements.seek.style.setProperty("--range-fill", `${player.elements.seek.value}%`);
            if (!audio.duration) return;
            const target = (Number(player.elements.seek.value) / 100) * audio.duration;
            if (player.elements.current) player.elements.current.textContent = formatAudioTime(target);
          }, listenerOptions);

          player.elements.seek?.addEventListener("change", () => {
            if (audio.duration) {
              audio.currentTime = (Number(player.elements.seek.value) / 100) * audio.duration;
            }
            player.seeking = false;
            updateMusicUi();
            saveMusicState();
          }, listenerOptions);

          player.audioAbort?.abort();
          player.audioAbort = new AbortController();
          const audioListenerOptions = { signal: player.audioAbort.signal };

          const tryResumeAfterRefresh = async () => {
            if (!player.pendingAutoplay || !audio.paused || !player.tracks.length) return;
            try {
              await audio.play();
              setMusicSessionAutoplayEnabled(true);
              player.pendingAutoplay = false;
              player.unlockAbort?.abort();
              updateMusicUi();
              saveMusicState();
            } catch {
              if (player.elements.note) player.elements.note.textContent = "浏览器需要一次交互后才能续播。";
            }
          };

          player.unlockAbort?.abort();
          player.unlockAbort = new AbortController();
          const unlockOptions = { signal: player.unlockAbort.signal, passive: true };
          ["pointerdown", "keydown", "wheel", "touchstart"].forEach((eventName) => {
            window.addEventListener(eventName, tryResumeAfterRefresh, unlockOptions);
          });

          audio.addEventListener("timeupdate", () => {
            updateMusicUi();
            saveMusicState();
          }, audioListenerOptions);
          audio.addEventListener("play", () => {
            setMusicSessionAutoplayEnabled(true);
            player.pendingAutoplay = false;
            updateMusicUi();
            saveMusicState();
          }, audioListenerOptions);
          audio.addEventListener("pause", () => {
            if (!player.pendingAutoplay) setMusicSessionAutoplayEnabled(false);
            updateMusicUi();
            saveMusicState();
          }, audioListenerOptions);
          audio.addEventListener("ended", () => {
            loadMusicTrack(player.index + 1, { autoplay: true });
          }, audioListenerOptions);
          window.addEventListener("pagehide", saveMusicState, listenerOptions);
          updateMusicUi();
        };

        player.init = initMusicPlayer;
        player.update = updateMusicUi;
        player.isAutoplayEnabled = isMusicAutoplayEnabled;
        player.setAutoplayEnabled = setMusicAutoplayEnabled;
        return player;
      };

      // ??= ：仅在 window.__lunkeyRadio 还不存在时才创建，保证单例（切换页面不会重复建播放器）。
      window.__lunkeyRadio ??= createlunkeyRadio();
      window.__lunkeyRadio.bind();
      window.__lunkeyRadio.init();
      document.addEventListener("astro:page-load", () => {
        window.__lunkeyRadio?.bind();
        window.__lunkeyRadio?.init();
      });

      // ---------- 区块 6：自定义右键菜单 ----------
      // sakura 开关写 localStorage；菜单定位到鼠标处，越界时自动收进视口内。
      const sakuraStateKey = "lunkey-sakura-enabled-v1";
      const getContextMenu = () => document.querySelector("[data-context-menu]");
      let contextMenuReturnFocus = null;
      const hideContextMenu = () => {
        const contextMenu = getContextMenu();
        const shouldRestoreFocus = contextMenu?.contains(document.activeElement);
        contextMenu?.classList.remove("is-open");
        if (shouldRestoreFocus && contextMenuReturnFocus instanceof HTMLElement) {
          contextMenuReturnFocus.focus({ preventScroll: true });
        }
      };
      const isSakuraEnabled = () => localStorage.getItem(sakuraStateKey) !== "0";
      const setSakuraEnabled = (enabled) => {
        localStorage.setItem(sakuraStateKey, enabled ? "1" : "0");
        document.body.classList.toggle("hide-sakura", !enabled);
      };
      const updateContextToggleLabels = () => {
        const contextMenu = getContextMenu();
        const sakuraButton = contextMenu?.querySelector('[data-context-action="sakura"]');
        const musicAutoplayButton = contextMenu?.querySelector('[data-context-action="music-autoplay"]');
        const currentTheme = window.__lunkeyTheme?.current ?? "lumen-kael-xystus";
        const sakuraEnabled = isSakuraEnabled();
        const musicAutoplayEnabled = window.__lunkeyRadio?.isAutoplayEnabled?.() ?? false;
        if (sakuraButton) {
          sakuraButton.textContent = sakuraEnabled ? "✿ 樱花雨：开" : "✿ 樱花雨：关";
          sakuraButton.setAttribute("aria-pressed", String(sakuraEnabled));
        }
        if (musicAutoplayButton) {
          musicAutoplayButton.textContent = musicAutoplayEnabled ? "♫ 进站续播：开" : "♫ 进站续播：关";
          musicAutoplayButton.setAttribute("aria-pressed", String(musicAutoplayEnabled));
        }
        contextMenu?.querySelectorAll("[data-theme-select]").forEach((button) => {
          const isCurrent = button.dataset.themeSelect === currentTheme;
          button.setAttribute("aria-pressed", String(isCurrent));
          const mark = button.querySelector(".context-theme-mark");
          if (mark) mark.textContent = isCurrent ? "●" : "○";
        });
      };

      setSakuraEnabled(isSakuraEnabled());
      updateContextToggleLabels();
      window.addEventListener("lunkey:music-autoplay-change", updateContextToggleLabels);

      const showContextMenuAt = (clientX, clientY, focusFirst = false) => {
        const contextMenu = getContextMenu();
        if (!contextMenu) return false;
        if (!contextMenu.contains(document.activeElement)) {
          const activeElement = document.activeElement;
          contextMenuReturnFocus = activeElement instanceof HTMLElement && activeElement !== document.body
            ? activeElement
            : document.querySelector(".theme-quick-switch");
        }
        updateContextToggleLabels();
        const menuWidth = contextMenu.offsetWidth;
        const menuHeight = contextMenu.offsetHeight;
        const x = Math.min(clientX, window.innerWidth - menuWidth - 12);
        const y = Math.min(clientY, window.innerHeight - menuHeight - 12);
        contextMenu.style.setProperty("--menu-x", `${Math.max(12, x)}px`);
        contextMenu.style.setProperty("--menu-y", `${Math.max(12, y)}px`);
        contextMenu.classList.add("is-open");
        if (focusFirst) contextMenu.querySelector("button")?.focus({ preventScroll: true });
        return true;
      };

      window.addEventListener("contextmenu", (event) => {
        event.preventDefault();
        showContextMenuAt(event.clientX, event.clientY);
      });
      window.addEventListener("lunkey:context-menu-request", (event) => {
        if (!(event instanceof CustomEvent)) return;
        const x = Number(event.detail?.clientX);
        const y = Number(event.detail?.clientY);
        showContextMenuAt(
          Number.isFinite(x) ? x : window.innerWidth / 2,
          Number.isFinite(y) ? y : window.innerHeight / 2
        );
      });
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") hideContextMenu();
        if (event.key === "ContextMenu" || (event.key === "F10" && event.shiftKey)) {
          event.preventDefault();
          const activeRect = document.activeElement?.getBoundingClientRect?.();
          const x = activeRect ? activeRect.left + Math.min(activeRect.width, 28) : window.innerWidth / 2;
          const y = activeRect ? activeRect.top + Math.min(activeRect.height, 28) : window.innerHeight / 2;
          showContextMenuAt(x, y, true);
        }
      });
      window.addEventListener("click", async (event) => {
        const contextMenu = getContextMenu();
        const target = event.target instanceof Element ? event.target : null;
        const themeButton = target?.closest("[data-theme-select]");
        if (themeButton) {
          event.stopPropagation();
          hideContextMenu();
          window.__lunkeyTheme?.select(themeButton.dataset.themeSelect);
          return;
        }

        const button = target?.closest("[data-context-action]");
        if (!button || !contextMenu?.contains(button)) {
          hideContextMenu();
          return;
        }

        event.stopPropagation();
        const action = button.dataset.contextAction;
        if (action === "top") window.scrollTo({ top: 0, behavior: "smooth" });
        if (action === "refresh") window.location.reload();
        if (action === "home") window.location.assign(import.meta.env.BASE_URL);
        if (action === "back") history.back();
        if (action === "forward") history.forward();
        if (action === "copy") {
          await navigator.clipboard?.writeText(window.location.href);
          button.textContent = "\u2713 \u94fe\u63a5\u5df2\u590d\u5236";
          window.setTimeout(() => {
            button.textContent = "\u29c9 \u590d\u5236\u94fe\u63a5";
          }, 1200);
        }
        if (action === "title") {
          await navigator.clipboard?.writeText(document.title);
          button.textContent = "\u2713 \u6807\u9898\u5df2\u590d\u5236";
          window.setTimeout(() => {
            button.textContent = "T \u590d\u5236\u6807\u9898";
          }, 1200);
        }
        if (action === "sakura") {
          setSakuraEnabled(!isSakuraEnabled());
          updateContextToggleLabels();
        }
        if (action === "music-autoplay") {
          const nextEnabled = !(window.__lunkeyRadio?.isAutoplayEnabled?.() ?? false);
          window.__lunkeyRadio?.setAutoplayEnabled?.(nextEnabled);
          updateContextToggleLabels();
        }
        hideContextMenu();
      });

      // ---------- 区块 7：代码块复制按钮 ----------
      // 给正文里未被 expressive-code 处理过的 <pre> 追加「⧉ Copy」按钮，点击复制代码。
      const enhanceCodeBlocks = () => {
        document.querySelectorAll(".prose pre:not(.expressive-code pre)").forEach((pre) => {
          if (pre.querySelector("[data-copy-code]")) return;
          const button = document.createElement("button");
          button.type = "button";
          button.className = "lunkey-copy-code";
          button.dataset.copyCode = "true";
          button.textContent = "⧉ Copy";
          button.addEventListener("click", async () => {
            const code = pre.querySelector("code")?.textContent ?? pre.textContent ?? "";
            try {
              await navigator.clipboard.writeText(code);
              button.textContent = "✓ Copied";
            } catch {
              button.textContent = "复制失败";
            }
            window.setTimeout(() => {
              button.textContent = "⧉ Copy";
            }, 1200);
          });
          pre.append(button);
        });
      };

      enhanceCodeBlocks();
      document.addEventListener("astro:page-load", enhanceCodeBlocks);
    </script>
  </body>
</html>
