<script>
  /**
   * 文件职责：漫画相关交互的统一「挂载器」，无 HTML 只跑脚本。
   * 用一张 [选择器 → 挂载函数] 的映射表，扫描页面上符合选择器的节点并挂载对应动效：
   *   漫画场景视差、章节轨道、回忆相册、存档页动效。
   * 被谁引用：BaseLayout.astro 末尾（全站加载）。
   * 改动影响：所有含 data-manga-* 节点的页面；具体逻辑在 ../lib/manga-runtime.mjs。
   */
  import { mountMangaScene, mountChapterRail, mountAlbum, mountArchive } from "../lib/manga-runtime.mjs";
  let cleanup: (() => void)[] = [];
  const dispose = () => { cleanup.splice(0).forEach((stop) => stop()); };
  const start = () => {
    dispose();
    if (!document.body.hasAttribute("data-lumenkaelxystus")) return;
    // 映射表：想给新的漫画区块加动效，加一行 [选择器, 挂载函数] 即可。
    for (const [selector, mount] of [
      ["[data-manga-scene]", mountMangaScene],
      ["[data-manga-rail]", mountChapterRail],
      ["[data-manga-album]", mountAlbum],
      ["[data-manga-archive]", mountArchive]
    ] as const) {
      document.querySelectorAll<HTMLElement>(selector).forEach((root) => cleanup.push(mount(root)));
    }
  };
  document.addEventListener("astro:page-load", start);
  // 视图过渡离开页面前：卸载漫画动效，并顺带清理首页公告弹窗与标签雨（它们把清理函数挂在 window 上）。
  document.addEventListener("astro:before-swap", () => {
    dispose();
    window.__lunNoticeCleanup?.();
    window.__lunHomeRainCleanup?.();
  });
</script>
