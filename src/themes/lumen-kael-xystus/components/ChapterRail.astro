---
/**
 * 文件职责：首页的「章节导航」——三张横向卡片（笔记/作品/关于），点击跳到对应页面。
 * data-manga-rail 是 MangaRuntime 的挂载点，负责进入视口时的滑入/切换动效。
 * 被谁引用：HomePage.astro（公告弹窗之后、标签雨之前）。
 * 改动影响：首页章节卡片；想改章节/链接，编辑下面的 chapters 数组。
 */
import { Icon } from "astro-icon/components";
import { getThemePath } from "@/core/themes/registry";
import MangaArt from "./MangaArt.astro";
import type { MangaImage } from "../data/mangaArt";
// chapters：每张章节卡片的数据。route 是目标路由，image 是主图，sticker 是角标装饰图。
// 想增删章节就改这个数组（记得 type 里的字段要齐全）。
const chapters: { route: string; label: string; title: string; note: string; image: MangaImage; sticker: MangaImage }[] = [
  { route: "/blog/", label: "01 / Notebook", title: "写下来的日子", note: "技术、随笔与忽然冒出的念头", image: "reading-strip", sticker: "kagari-schoolbag" },
  { route: "/projects/", label: "02 / Atelier", title: "还在生长的作品", note: "把灵感变成可以触碰的小东西", image: "workshop-strip", sticker: "haruto-reading" },
  { route: "/about/", label: "03 / Dear reader", title: "关于这里的我", note: "喜欢的故事，总想与你聊聊", image: "hand-note", sticker: "kagari-cozy" }
];
---
<section class="chapter-rail" data-manga-rail aria-labelledby="chapter-rail-title">
  <div class="chapter-rail-stage">
    <header class="manga-section-heading">
      <div><p class="section-kicker">A little table of contents</p><h2 id="chapter-rail-title">故事，从哪一页开始？</h2></div>
      <div class="manga-rail-status">
        <span data-rail-position aria-live="polite">01 / 04</span>
        <span class="manga-rail-progress" data-rail-progress aria-hidden="true"></span>
      </div>
    </header>
    <!-- 章节轨道：tabindex="0" 让它可用键盘聚焦；data-rail-* 供动效脚本定位当前项与进度。 -->
    <div class="chapter-track" id="home-chapters" data-rail-track tabindex="0" aria-label="手帖章节">
      <!-- map 生成章节卡片：只有首项带 data-rail-active（高亮）；链接经 getThemePath 加主题前缀。 -->
      {chapters.map((chapter, index) => (
        <a class="chapter-leaf" data-rail-active={index === 0 ? "true" : undefined} href={getThemePath("lumen-kael-xystus", chapter.route)}>
          <span class="chapter-number">{chapter.label}</span>
          <div class="chapter-picture"><MangaArt image={chapter.image} /></div>
          <MangaArt image={chapter.sticker} class="chapter-sticker" />
          <div class="chapter-caption"><h3>{chapter.title}</h3><p>{chapter.note}</p></div>
          <Icon name="tabler:arrow-up" class="chapter-arrow" aria-hidden="true" />
        </a>
      ))}
    </div>
  </div>
</section>
