---
/**
 * 文件职责：「夹在书里的片刻」回忆相册——3 张彩页用标签页切换，一次只显示一张。
 * data-manga-album 是 MangaRuntime 的挂载点，由它实现点击标签切换 is-active/显示隐藏。
 * 被谁引用：AboutPage.astro（区块 05）。
 * 改动影响：关于页的相册；想加/改彩页编辑下面 pages 数组，配图来自 data/mangaArt.ts。
 */
import MangaArt from "./MangaArt.astro";
// pages：相册的三张彩页定义（图片名、标题、副标题、无障碍描述）。
const pages = [
  { image: "festival-cover" as const, title: "我将跨越七大海洋，去和你相见", subtitle: "久岛 鸥 / kamome", alt: "久岛 鸥" },
  { image: "afternoon-cover" as const, title: "心脏还在跳动", subtitle: "生命 /生きる ", alt: "生命" },
  { image: "together-cover" as const, title: "终有一日,我们会回首过往……", subtitle: "回忆 / memory", alt: "白羽" }
];
---
<section class="memory-album" data-manga-album aria-labelledby="memory-album-title">
  <header class="me-section-heading">
    <div><p class="me-eyebrow">05 / Between the pages</p><h2 id="memory-album-title">夹在书里的片刻</h2></div>
    <!-- 标签按钮组：data-album-tab 存索引，aria-controls 指向对应彩页的 id，首项默认选中。 -->
    <div class="album-tabs" role="group" aria-label="选择彩页">
      {pages.map((page, i) => <button type="button" data-album-tab={i} aria-pressed={i === 0 ? "true" : "false"} aria-controls={`memory-page-${i}`} title={page.title}>{String(i + 1).padStart(2, "0")}</button>)}
    </div>
  </header>
  <div class="album-pages">
    <!-- 彩页循环：只有第一张不带 hidden（默认显示），其余隐藏由脚本切换。 -->
    {pages.map((page, i) => (
      <figure class="album-page" id={`memory-page-${i}`} data-album-page hidden={i !== 0}>
        <div class="album-illustration"><MangaArt image={page.image} alt={page.alt} /></div>
        <figcaption><span>{page.subtitle}</span><h3>{page.title}</h3><small>「眩しさだけは、忘れなかった。」</small></figcaption>
      </figure>
    ))}
    <MangaArt image="festival-pair" class="album-companion" />
  </div>
</section>
