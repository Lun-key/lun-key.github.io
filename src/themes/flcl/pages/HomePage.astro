---
// FLCL Theme - 物语系列风格，硬边极简黑白红
import "../styles/theme.css";
import SeoMeta from "@/core/SeoMeta.astro";
import ThemePreferenceGate from "@/core/themes/ThemePreferenceGate.astro";
import ThemeLongPressMenu from "@/core/themes/ThemeLongPressMenu.astro";
import ConsoleEasterEgg from "@/core/ConsoleEasterEgg.astro";
import { site } from "@/lib/site";
import { getThemePath } from "@/core/themes/registry";
import { ClientRouter } from "astro:transitions";

// 章节导航数据
const chapters = [
  { num: "01", href: "/blog/",     title: "NOTES",    sub: "文字 / 记录" },
  { num: "02", href: "/projects/", title: "WORKS",    sub: "作品 / 创作" },
  { num: "03", href: "/about/",    title: "ME",       sub: "关于 / 我" },
];

const navItems = [
  { href: "/",           label: "HOME" },
  { href: "/blog/",      label: "BLOG" },
  { href: "/projects/",  label: "WORKS" },
  { href: "/about/",     label: "ME" },
];

const themeBase = getThemePath("flcl", "/");
---

<!doctype html>
<html lang="zh-CN" data-theme="flcl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,follow" />
  <title>FLCL · {site.name}</title>
  <ThemePreferenceGate currentTheme="flcl" />
  <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}themes/lumen-kael-xystus/assets/mascot-favicon-navy.png`} />
  <ClientRouter />
  <ConsoleEasterEgg />
</head>
<body data-flcl>
  <ThemeLongPressMenu />

  <!-- 导航栏 -->
  <nav class="fc-nav" data-navbar>
    <div class="fc-nav-inner">
      <a href={themeBase} class="fc-brand">
        <span class="fc-brand-mark">◆</span>
        <span class="fc-brand-name">L·K·X</span>
      </a>
      <ul class="fc-menu">
        {navItems.map((item) => (
          <li class="fc-item">
            <a
              href={getThemePath("flcl", item.href)}
              class="fc-link"
              data-path={getThemePath("flcl", item.href)}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="fc-right">
        <span class="fc-hint">长按 / THEME</span>
      </div>
    </div>
    <div class="fc-border"></div>
  </nav>

  <!-- 主内容 -->
  <main class="fc-home-layer" id="page-content">

    <!-- 打字机氛围文字 -->
    <div class="fc-typewriter-zone">
      <p class="fc-tw-line" data-fc-tw="0">这里是碎片，也是记录。</p>
      <p class="fc-tw-line" data-fc-tw="1">L·K·X — {site.name}</p>
      <p class="fc-tw-line" data-fc-tw="2">// version 2026 · still loading</p>
    </div>

    <!-- 碎片化拼贴区 -->
    <div class="fc-scatter-grid" aria-hidden="true">
      <div class="fc-frag fc-frag--title" style="grid-column: 1/4; grid-row: 1/4;">
        <span class="fc-frag-text">LKX</span>
      </div>
      <div class="fc-frag fc-frag--vertical" style="grid-column: 4/5; grid-row: 1/3;">
        <span>LUMEN·KAEL·XYSTUS</span>
      </div>
      <div class="fc-frag fc-frag--red" style="grid-column: 5/6; grid-row: 1/2;">
        <span>◆</span>
      </div>
      <div class="fc-frag fc-frag--code" style="grid-column: 4/6; grid-row: 3/4;">
        <span>→ /blog /works /me</span>
      </div>
      <div class="fc-frag fc-frag--rule" style="grid-column: 1/6; grid-row: 4/5;"></div>
      <div class="fc-frag fc-frag--sm" style="grid-column: 1/3; grid-row: 5/7;">
        <span>二次元 / 技术 / 折腾<br/>以上皆是。</span>
      </div>
      <div class="fc-frag fc-frag--lg" style="grid-column: 3/6; grid-row: 5/7;">
        <span>2026</span>
      </div>
    </div>

    <!-- 章节入口 -->
    <nav class="fc-chapters" aria-label="页面导航">
      {chapters.map((ch) => (
        <a
          class="fc-chapter-item"
          href={getThemePath("flcl", ch.href)}
        >
          <span class="fc-ch-num">{ch.num}</span>
          <span class="fc-ch-title">{ch.title}</span>
          <span class="fc-ch-sub">{ch.sub}</span>
          <span class="fc-ch-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>

  </main>

  <!-- 主题切换快速菜单 -->
  <nav class="custom-context-menu" data-context-menu aria-label="快捷菜单">
    <button type="button" data-context-action="top">↑ 回到顶部</button>
    <button type="button" data-context-action="refresh">↻ 刷新页面</button>
    <button type="button" data-context-action="home">⌂ 返回首页</button>
    <button type="button" data-context-action="back">← 后退</button>
    <button type="button" data-context-action="copy">⧉ 复制链接</button>
    <div class="context-theme-group" aria-label="选择主题">
      <span class="context-theme-label">THEME</span>
      <button type="button" data-theme-select="flcl" aria-pressed="true">
        <span class="context-theme-mark" aria-hidden="true">●</span>
        FLCL
      </button>
      <button type="button" data-theme-select="lumen-kael-xystus" aria-pressed="false">
        <span class="context-theme-mark" aria-hidden="true">○</span>
        Lumen Kael Xystus
      </button>
    </div>
  </nav>

  <!-- 导航激活状态脚本 -->
  <script is:inline>
  (function () {
    var nav = document.querySelector('[data-navbar]');
    if (!nav) return;
    var path = location.pathname.replace(/\/$/, '') || '/';
    nav.querySelectorAll('[data-path]').forEach(function (a) {
      var p = a.getAttribute('data-path').replace(/\/$/, '') || '/';
      if (p === path || (path !== '/' && p !== '/' && path.startsWith(p)))
        a.classList.add('is-active');
    });
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        nav.classList.toggle('is-scrolled', window.scrollY > 40);
        ticking = false;
      });
    });
  })();
  </script>

  <!-- 长按菜单脚本 -->
  <script is:inline>
  (function () {
    var menu = document.querySelector('[data-context-menu]');
    if (!menu) return;
    var delay = 620, timer = 0, startX = 0, startY = 0;

    function open(x, y) {
      menu.style.left = Math.min(x, window.innerWidth - 220) + 'px';
      menu.style.top  = Math.min(y, window.innerHeight - menu.offsetHeight - 8) + 'px';
      menu.classList.add('is-open');
    }
    function close() { menu.classList.remove('is-open'); }

    document.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'touch') return;
      startX = e.clientX; startY = e.clientY;
      timer = window.setTimeout(function () { open(startX, startY); }, delay);
    });
    document.addEventListener('pointermove', function (e) {
      if (Math.hypot(e.clientX - startX, e.clientY - startY) > 10) {
        clearTimeout(timer);
      }
    });
    document.addEventListener('pointerup',     function () { clearTimeout(timer); });
    document.addEventListener('pointercancel', function () { clearTimeout(timer); });
    document.addEventListener('contextmenu', function (e) {
      e.preventDefault(); open(e.clientX, e.clientY);
    });
    document.addEventListener('click', function (e) {
      if (!menu.contains(e.target)) close();
    });

    menu.querySelectorAll('[data-context-action]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var action = btn.dataset.contextAction;
        if (action === 'top')     window.scrollTo({ top: 0, behavior: 'smooth' });
        if (action === 'refresh') location.reload();
        if (action === 'home')    location.href = '/themes/flcl/';
        if (action === 'back')    history.back();
        if (action === 'copy')    navigator.clipboard?.writeText(location.href);
        close();
      });
    });

    menu.querySelectorAll('[data-theme-select]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.dataset.themeSelect;
        window.__lumenkaelTheme?.select(id);
        close();
      });
    });
  })();
  </script>

  <!-- 导航栏样式 -->
  <style>
    .fc-nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 9000;
      background: var(--white-pure, #fff);
      transition: box-shadow 0.3s ease;
    }
    .fc-nav.is-scrolled { box-shadow: 0 2px 0 #000; }
    .fc-nav-inner {
      max-width: 1280px; margin: 0 auto;
      padding: 1.1rem 2rem;
      display: flex; align-items: center; gap: 2rem;
      transition: padding 0.3s ease;
    }
    .fc-nav.is-scrolled .fc-nav-inner { padding: 0.75rem 2rem; }
    .fc-brand {
      display: flex; align-items: center; gap: 0.4rem;
      text-decoration: none; color: #000;
      font-weight: 900; font-size: 1rem; letter-spacing: 0.08em;
    }
    .fc-brand-mark { color: var(--red-title, #c41e3a); font-size: 0.65rem; }
    .fc-brand-name { letter-spacing: 0.2em; }
    .fc-menu { list-style: none; display: flex; gap: 0; margin: 0; padding: 0; }
    .fc-link {
      display: block; padding: 0.5rem 1rem;
      text-decoration: none; color: #2a2a2a;
      font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em;
      border: 1px solid transparent;
      transition: border-color 0.15s, background 0.15s, color 0.15s;
    }
    @media (hover: hover) and (pointer: fine) {
      .fc-link:hover { border-color: #000; }
    }
    .fc-link.is-active {
      background: var(--red-title, #c41e3a); color: #fff;
      border: 1px solid #000;
    }
    .fc-right { margin-left: auto; }
    .fc-hint { font-size: 0.65rem; color: #666; letter-spacing: 0.15em; font-weight: 600; }
    .fc-border { height: 2px; background: #000; }

    /* 右键菜单 */
    .custom-context-menu {
      position: fixed; z-index: 9999;
      background: var(--white-pure, #fff);
      border: 2px solid #000;
      box-shadow: var(--shadow-hard, 6px 6px 0 rgba(0,0,0,.15));
      padding: 0.5rem 0;
      min-width: 180px;
      display: none;
    }
    .custom-context-menu.is-open { display: block; }
    .custom-context-menu button {
      display: block; width: 100%;
      padding: 0.5rem 1rem; background: none; border: none;
      text-align: left; cursor: pointer;
      font-size: 0.8rem; letter-spacing: 0.08em; color: #0a0a0a;
      transition: background 0.1s;
    }
    .custom-context-menu button:hover { background: #0a0a0a; color: #fff; }
    .context-theme-group {
      border-top: 1px solid #e0e0e0; margin-top: 0.5rem; padding-top: 0.5rem;
    }
    .context-theme-label {
      display: block; padding: 0.3rem 1rem;
      font-size: 0.65rem; font-weight: 700;
      letter-spacing: 0.2em; color: #888;
    }
    .context-theme-mark { margin-right: 0.4rem; }

    @media (max-width: 768px) {
      .fc-right { display: none; }
      .fc-nav-inner { padding: 0.75rem 1rem; }
      .fc-link { padding: 0.4rem 0.6rem; letter-spacing: 0.08em; }
    }
  </style>

</body>
</html>
