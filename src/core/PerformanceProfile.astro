<!--
  文件：性能档位探测（PerformanceProfile.astro）。
  做什么：根据系统“减少动画”、指针类型、屏幕宽度、内存/核心数、网络状况，把页面分级为
         lite（精简）/ mobile（移动）/ full（完整），写入 <html data-lumenkael-performance>，供样式与脚本降载。
  被谁引用：themes/lumen-kael-xystus/layouts/BaseLayout.astro。
  改它会怎样：改档位判断阈值 → 多少设备会被降级；data-lumenkael-pointer 供样式区分触摸/鼠标。
  这是纯浏览器脚本（is:inline），在页面加载时跑一次，并在窗口变化/网络变化时重算。
-->
<script is:inline data-astro-rerun>
  // data-astro-rerun：视图切换后重新执行；先跑上次的 cleanup 避免重复绑定。
  (() => {
    window.__lumenkaelPerformanceProfileCleanup?.();

    const lifecycle = new AbortController();
    const root = document.documentElement;
    const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    let resizeTimer = 0;

    // 核心函数：综合多项设备信号算出性能档位。可修改点：下面的阈值（820px、内存/核心数 ≤2 等）。
    const applyProfile = () => {
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const coarsePointer = window.matchMedia("(pointer: coarse)").matches;
      const compactViewport = window.matchMedia("(max-width: 820px)").matches;
      const mobile = coarsePointer || compactViewport;
      const memory = Number(navigator.deviceMemory) || 0;
      const cores = Number(navigator.hardwareConcurrency) || 0;
      const effectiveType = String(connection?.effectiveType || "").toLowerCase();
      const constrainedNetwork = Boolean(connection?.saveData) || /(^|-)2g$/.test(effectiveType);
      const constrainedDevice = mobile && ((memory > 0 && memory <= 2) || (cores > 0 && cores <= 2));
      // 档位优先级：省电/弱网/弱设备 → lite；否则移动设备 → mobile；其余 → full。
      const profile = reducedMotion || constrainedNetwork || constrainedDevice
        ? "lite"
        : mobile
          ? "mobile"
          : "full";

      root.dataset.lumenkaelPerformance = profile;
      root.dataset.lumenkaelPointer = coarsePointer ? "coarse" : "fine";
    };

    const applyVisibility = () => {
      root.dataset.lumenkaelVisibility = document.visibilityState;
    };

    const scheduleProfileRefresh = () => {
      if (resizeTimer) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resizeTimer = 0;
        applyProfile();
      }, 180);
    };

    applyProfile();
    applyVisibility();
    window.addEventListener("resize", scheduleProfileRefresh, { passive: true, signal: lifecycle.signal });
    window.addEventListener("orientationchange", scheduleProfileRefresh, { passive: true, signal: lifecycle.signal });
    document.addEventListener("visibilitychange", applyVisibility, { signal: lifecycle.signal });
    connection?.addEventListener?.("change", applyProfile, { signal: lifecycle.signal });

    // 卸载函数：清掉防抖定时器并 abort 所有监听器，页面切换时调用。
    const cleanup = () => {
      if (resizeTimer) window.clearTimeout(resizeTimer);
      resizeTimer = 0;
      lifecycle.abort();
      if (window.__lumenkaelPerformanceProfileCleanup === cleanup) {
        window.__lumenkaelPerformanceProfileCleanup = null;
      }
    };
    window.__lumenkaelPerformanceProfileCleanup = cleanup;
  })();
</script>
