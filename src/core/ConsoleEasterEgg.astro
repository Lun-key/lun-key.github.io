<!--
  文件：控制台彩蛋（ConsoleEasterEgg.astro）。
  做什么：在浏览器控制台打印一段 ASCII 字符画（爱心 + 钥匙）和几句留言，纯装饰、不影响功能。
  被谁引用：BaseLayout.astro、flcl 的 HomePage.astro。
  改它会怎样：改 heart / key 两个数组的字符串可换字符画；改 console.log 的样式字符串可换颜色字号；
             提示语里提到输入 lumenkaelSignal() 可再次呼出，若改了函数名要同步改这句提示。
-->
<script is:inline>
  (() => {
    // 打印彩蛋的主体函数：把两幅字符画逐行拼在一起，再用带 %c 样式的 console.log 输出彩色文本。
    const renderSignal = () => {
      // heart 和 key 各是一行行的字符画，索引相同的行会被拼到同一行。想换图案就改这些字符串。
      const heart = [
        "  **   ** ",
        " **** ****",
        "***********",
        " ********* ",
        "  *******  ",
        "   *****   ",
        "    ***    ",
        "     *     "
      ];
      const key = [
        "  .----.    ",
        " /      \\   ",
        "|  ()  |=====>",
        " \\____/     ",
        "            "
      ];
      const art = heart
        .map((line, index) => `${line.padEnd(18, " ")}${key[index]}`)
        .join("\n");

      console.log(
        "%c" + art,
        "color:#ff6b9d;font-family:monospace;font-size:13px;line-height:1.15;font-weight:700;"
      );
      console.log(
        "%cLUNKEY LAB  /  HIDDEN SIGNAL 01",
        "color:#8fa7ff;font-family:monospace;font-size:12px;font-weight:700;letter-spacing:1px;"
      );
      console.log(
        "%c♥ 记录心动，⚿ 保存好奇。你已经找到控制台里的小房间。",
        "color:#f3b6ca;font-size:12px;"
      );
      console.log(
        "%c愿每次打开网页，都能捡到一点灵感。输入 lumenkaelSignal() 可以再次呼出。",
        "color:#aeb8d8;font-size:11px;"
      );
    };

    // 暴露到全局，访客在控制台输入 lumenkaelSignal() 就能再打印一次；用标记位保证首次只自动打印一次。
    window.lumenkaelSignal = renderSignal;
    if (window.__lumenkaelConsoleEasterEggShown) return;
    window.__lumenkaelConsoleEasterEggShown = true;
    renderSignal();
  })();
</script>
